generator client {
  provider = "prisma-client-js"
 }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parentId    String?
  imageUrl    String?
  vatRate     Float    @default(0.21)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  image           String?
  unitType        UnitType
  price           Int
  netWeightGr     Int?
  netVolumeMl     Int?
  stock           Int       @default(0)
  reservedStock   Int       @default(0)
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  categoryId      String
  isOnSale        Boolean   @default(false)
  salePrice       Int?
  saleEndDate     DateTime?
  discountPercent Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  vatRate         Float?

  minPurchaseQty   Float?
  qtyStep          Float?
  maxPurchaseQty   Float?
  allowsDecimals   Boolean  @default(false)

  measurementUnit  String   @default("un")
  unitMultiplier   Float    @default(1)
  brand            String?

  orderItems OrderItem[]
  comboItems ComboItem[]
  category   Category    @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isActive, createdAt])
  @@index([isOnSale])
  @@index([isFeatured])
}

model Combo {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  imageUrl      String?
  stock         Int            @default(0)
  reservedStock Int            @default(0)
  priceType     ComboPriceType @default(FIXED)
  priceValue  Int
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items      ComboItem[]
  orderItems OrderItem[]

  @@index([isActive])
  @@index([slug])
}

model ComboItem {
  id        String   @id @default(cuid())
  comboId   String
  productId String
  quantity  Int
  createdAt DateTime @default(now())

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([comboId, productId])
  @@index([comboId])
  @@index([productId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  username      String?  @unique
  phone         String?
  image         String?
  role          UserRole @default(CUSTOMER)
  receiveOffers Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders           Order[]
  checkoutSessions CheckoutSession[]
  resetTokens      PasswordResetToken[]

  @@index([email])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName String
  phone        String
  email        String?

  status         OrderStatus    @default(PENDING_PAYMENT)
  deliveryMethod DeliveryMethod

  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(PENDING)
  paidAt              DateTime?
  mpPaymentId         String?       @unique
  mpStatus            String?
  mpPreferenceId      String?
  mpExternalReference String?

  // Talo Pay (transferencia CVU/alias)
  taloPaymentId String?   @unique
  taloStatus    String?
  taloCvu       String?
  taloAlias     String?
  taloExpiresAt DateTime?

  address        String?
  addressDetails String?
  city           String?
  postalCode     String?
  notes          String?

  pickupDate     DateTime?
  pickupTimeSlot String?
  pickupNotes    String?

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  // Bank transfer fields
  transferCode          String?         @unique // Format: CN-YYYY-NNNNNN
  transferStatus        TransferStatus?
  transferProofUrl      String?         // Cloudinary URL of the payment proof
  transferProofMimeType String?         // MIME type of the proof (image/jpeg, application/pdf, etc.)
  transferConfirmedAt   DateTime?
  transferRejectedAt    DateTime?
  transferRejectNote    String?         // Admin's rejection reason

  subtotal     Int
  deliveryCost Int @default(0)
  total        Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  items             OrderItem[]
  checkoutSessions  CheckoutSession[]

  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([email])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  comboId   String?
  quantity  Float
  unitPrice Int
  lineTotal Int

  // Snapshot del nombre al momento de la compra (el producto/combo puede
  // renombrarse después). El precio ya se snapshotea via unitPrice/lineTotal.
  itemNameSnapshot String?

  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([comboId])
}

model CheckoutSession {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName   String
  phone          String
  email          String?
  deliveryMethod DeliveryMethod
  address        String?
  addressDetails String?
  city           String?
  postalCode     String?
  notes          String?

  pickupDate     DateTime?
  pickupTimeSlot String?
  pickupNotes    String?

  itemsSnapshot Json
  subtotal      Int
  deliveryCost  Int
  total         Int

  status CheckoutSessionStatus @default(WAITING_MP)

  mpPreferenceId String?
  mpPaymentId    String?   @unique
  mpStatus       String?
  approvedAt     DateTime?

  // Talo Pay (transferencia CVU/alias)
  taloPaymentId String?   @unique
  taloStatus    String?
  taloCvu       String?
  taloAlias     String?
  taloExpiresAt DateTime?

  expiresAt           DateTime?
  reservationReleased Boolean  @default(false)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([email])
  @@index([expiresAt])
}

model TransferCodeSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model Feedback {
  id         Int      @id @default(autoincrement())
  estrellas  Int?
  encontro   Boolean?
  compraria  String?
  comentario String?
  createdAt  DateTime @default(now())
}

enum UnitType {
  PER_KG
  PER_UNIT
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum UserRole {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum PaymentMethod {
  MERCADO_PAGO  // Credit/debit card via Mercado Pago
  CASH          // Cash payment at pickup or delivery
  BANK_TRANSFER // Bank transfer (CVU/alias) - manual, con comprobante
  TALO_PAY      // Bank transfer (CVU/alias) - automático vía Talo Pay
}

enum TransferStatus {
  AWAITING_PROOF // Customer hasn't uploaded proof yet
  PENDING_REVIEW // Proof uploaded, admin must verify
  CONFIRMED      // Admin confirmed payment received
  REJECTED       // Admin rejected (mismatch or not found)
}

enum PaymentStatus {
  PENDING
  PENDING_LOCAL
  PAID
  FAILED
  CANCELLED
}

enum CheckoutSessionStatus {
  WAITING_MP
  WAITING_TALO
  PENDING
  APPROVED
  FAILED
  EXPIRED
}

enum ComboPriceType {
  FIXED
  PERCENTAGE_DISCOUNT
}
/// Horario del local editable desde el admin. Un registro por día (0 = domingo).
/// Horas en "HH:mm", hora Argentina. Si falta o es inválido, la app usa el horario fijo de lib/business-hours.ts.
model BusinessHours {
  dayOfWeek      Int      @id
  openMorning    String?
  closeMorning   String?
  openAfternoon  String?
  closeAfternoon String?
  isClosed       Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}
