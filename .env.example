# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/carniceria
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=carniceria

# NextAuth
NEXTAUTH_URL=https://carniceriaelnegro.com
NEXTAUTH_SECRET=

# Cloudinary (imágenes de productos)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=shop_carniceria/products

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_URL=https://carniceriaelnegro.com/api/mercadopago/webhook

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://carniceriaelnegro.com
APP_URL=https://carniceriaelnegro.com

# WhatsApp flotante (solo dígitos, con código de país, sin + ni espacios, ej: 5493458556104)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email transaccional (Resend)
RESEND_API_KEY=
MAIL_FROM="Carnicería El Negro <soporte@carniceriaelnegro.com>"
SUPPORT_EMAIL=

# Telegram (notificaciones de nuevas órdenes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin inicial (seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Build
# NEXT_DIST_DIR=.next

# Misc
RESET_TOKEN_TTL_MIN=30
